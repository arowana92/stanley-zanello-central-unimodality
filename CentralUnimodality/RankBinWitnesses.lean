module

public import CentralUnimodality.RankBinArithmetic

/-! Witness rank shifts for a coarser partition of the two right-flank
sign tests. Each hexadecimal digit indexes the list of allowed shifts.
The Python verifier reconstructs the witnesses by exact rational minimization. -/
@[expose] public section

namespace CentralUnimodality.MarkedExcursion.BinArithmetic

structure ShiftRow where
  mass : ℕ
  forward : ℕ
  curvature : ℕ
  late : ℕ
  deriving Inhabited

def growthShifts : Array ShiftRow := #[⟨0xbabbbbba999988888888999b99988776655444332, 0xbabbbbbbbbbbaaaaaaababaaa9887766554332100, 0xbabbbbbbbbbbbbbbbbbbbbbaa9887765544300000, 0x999⟩,
  ⟨0x8a988877777766666666666777788887766554433, 0xbbbba999888877777777778889998877665443320, 0xbbbbbbbaa999988888888899aa998877655443000, 0xbbb⟩,
  ⟨0x67766665555555555555555555556677776655443, 0x89887777666666666555566666677887766554321, 0xbbba9988777777766666666677778887766544300, 0xbb9⟩,
  ⟨0x55555544444443333333333344444455676665544, 0x77766655555554444444444444555566776655432, 0x89887776666555555555555555556667776654430, 0xb97⟩,
  ⟨0x34443333332222222222222222233333445665544, 0x56555444443333333333333333333444557665443, 0x77766655554444444333333333444455567665432, 0x975⟩,
  ⟨0x23322111100000000000000000001112233456554, 0x45443333222111111100000011111223334565543, 0x56555444333333222222111112222333345665543, 0x764⟩,
  ⟨0x1000000000000000000000000000000011234554, 0x33322111000000000000000000000000112346544, 0x45443332221110000000000000000001123456543, 0x643⟩,
  ⟨0x13455, 0x12100000000000000000000000000000000023554, 0x34332110000000000000000000000000000134554, 0x531⟩,
  ⟨0x245, 0x344, 0x12110000000000000000000000000000000001344, 0x410⟩]

def curvatureShifts : Array ShiftRow := #[⟨0x998877777766666666666666777888776655544332, 0xbbba99888877777777777778888988776554432100, 0xbbbbbbaa999888888888888999a988776554320000, 0xbbb⟩,
  ⟨0x776666555555555555555555555566777766554432, 0x998877766666665555555556666678777665443210, 0xbba998877777766666666666777789877665443000, 0xbb8⟩,
  ⟨0x555554444443333333333333344444556776554433, 0x776665555554444444444444444555666766544320, 0x988777666655555555555555555566677766543200, 0xb87⟩,
  ⟨0x444333332222222111111112222233334457655443, 0x555554444333333333322233333333445566554331, 0x776665555444444333333333334444555676554300, 0x875⟩,
  ⟨0x232211100000000000000000000001122334565543, 0x444333322211111000000000001111233345555432, 0x665554443333322222111111112223334457655420, 0x754⟩,
  ⟨0x10000000000000000000000000000000113355543, 0x333211100000000000000000000000001123455432, 0x554433322111000000000000000000011234555430, 0x643⟩,
  ⟨0x134544, 0x111000000000000000000000000000000001245543, 0x333221000000000000000000000000000002355440, 0x531⟩]

def shiftRow (curve : Bool) (i : ℕ) := (if curve then curvatureShifts else growthShifts)[i]?.getD default

def shiftValue (n : ℕ) : ℚ := (#[(0:ℚ),1,2,4,6,9,12,16,20,24,28,32][n]?).getD 0

def firstShift (row : ShiftRow) (i : ℕ) (r : Fin 3) :=
  let code := if r=0 then row.mass else if r=1 then row.forward else row.curvature
  shiftValue (code/16^i%16)

def lateShift (row : ShiftRow) (r : Fin 3) := shiftValue (row.late/16^r.val%16)

end CentralUnimodality.MarkedExcursion.BinArithmetic
