module

public import CentralUnimodality.PeakPrefixNumbers

/-! Exact prefix parameters and shift witnesses for signed growth.
Reproduce the packed digits with `python3 -B verify_peak_growth.py --lean-witnesses`.
Each seven-bit digit records twice the integer shift plus the area-estimate flag. -/
@[expose] public section

namespace CentralUnimodality.MarkedExcursion.BinArithmetic.Peak

def tabulated (i : Fin 7) : SaddleBin :=
  (#v[⟨3597/500, 14513/2000, firstCut, 256301/1000000, 128459/500000, 14717798847609/4096000000000, 6872099/1000000, 456501/1000000, 795843/1000000⟩,
    ⟨14513/2000, 1861/250, firstCut, 256279/1000000, 128459/500000, 2850315071896303/786432000000000, 6913857/1000000, 28767/62500, 794343/1000000⟩,
    ⟨1861/250, 3847/500, firstCut, 41/160, 128459/500000, 5710546759619/1536000000000, 7039659/1000000, 458573/1000000, 795019/1000000⟩,
    ⟨3847/500, 993/125, firstCut, 256219/1000000, 128459/500000, 47215002673577/12288000000000, 7208593/1000000, 90653/200000, 797133/1000000⟩,
    ⟨993/125, 4097/500, firstCut, 256187/1000000, 128459/500000, 253881617781/64000000000, 922353/125000, 112103/250000, 799071/1000000⟩,
    ⟨4097/500, 4347/500, firstCut, 256121/1000000, 128459/500000, 50275166179327/12288000000000, 943783/125000, 226787/500000, 79701/100000⟩,
    ⟨4347/500, 3597/400, firstCut, 256079/1000000, 128459/500000, 17777931103359/4096000000000, 7896447/1000000, 109477/250000, 803283/1000000⟩] : Vector SaddleBin 7)[i]

deriving instance DecidableEq for SaddleBin

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem tabulated_eq (i : Fin 7) : tabulated i=bin i := by
  fin_cases i <;> decide +kernel

structure HitShifts where
  packed : ℕ
  late : ℕ

def shifts (i : Fin 7) : HitShifts :=
  (#v[⟨, 20⟩,
    ⟨, 21⟩,
    ⟨, 21⟩,
    ⟨, 22⟩,
    ⟨0x366ce1d3c7d0204081020408101f3e810203c80f1d407cf9e3a74e1c386cd9b366cd9b366cd9b3870e1d3c7cd9c3a80e9c3874e1d3468c982e58a91a34684f9d366cc99325cb952a4c991223c78f1a3458b1624489121c3870a14285060c183, 23⟩,
    ⟨0x3870e9e3e8102040810204081020407d01e3a80f9e3a70e1b3668d193264c993260c183060c993264c9a346ce1d3c80d9d3678f1b346cc99305cb1625468509f3a6cd9b325cb972a4c993224478f1a3468b162c48912243870e142850a0c183, 23⟩,
    ⟨0x3c7cfa040810204080f9f3e80f203c74e1b3468c98305cb972c58b162a54a952a54a952a54a952a54a952c58b172e60c193470f9a3c70e193260b962c4a8d2a1427ce9d3664c992e54a93264c8911e3c68d1a2c58912244870e1c2850a0c183, 24⟩] : Vector HitShifts 7)[i]

def methodCode (row : HitShifts) (j : ℕ) : ℕ := (row.packed >>> (7*j))%128
def stepCount (i : Fin 7) : ℕ := if i=0 then 512 else if i.val<4 then 256 else 128
def timeBins (i : Fin 7) : ℕ := if i=0 then 436 else if i.val<4 then 218 else 109
def timeEdge (i : Fin 7) (j : ℕ) : ℚ := min (finalCut+2*epsilon) (firstCut+(j:ℚ)/stepCount i)

end CentralUnimodality.MarkedExcursion.BinArithmetic.Peak
